    {
      "name": "simple completed segment",
      "steps": [
        [
          0,
          0
        ],
        [
          1500,
          10
        ],
        [
          1500,
          60
        ],
        [
          1500,
          70
        ],
        [
          0,
          30
        ],
        [
          0,
          500
        ]
      ],
      "expectVoiced": [
        false,
        true,
        true,
        true,
        false,
        false
      ],
      "expectSegmentStartIndex": 1,
      "expectOutcome": "completed"
    },
    {
      "name": "sub-threshold amplitudes never open a segment",
      "steps": [
        [
          100,
          10
        ],
        [
          210,
          30
        ],
        [
          150,
          30
        ],
        [
          0,
          500
        ]
      ],
      "expectVoiced": [
        false,
        false,
        false,
        false
      ],
      "expectSegmentStartIndex": -1,
      "expectOutcome": "none"
    },
    {
      "name": "short blip resolves ignored",
      "steps": [
        [
          0,
          0
        ],
        [
          1500,
          10
        ],
        [
          0,
          30
        ],
        [
          0,
          600
        ]
      ],
      "expectVoiced": [
        false,
        true,
        false,
        false
