# Copy to .env and fill in your keys. Loaded from repo root when you run: pnpm start, pnpm web-client:dev, etc.

# Required for voice + default agent
GEMINI_API_KEY=

# Required for Claude Code agent profile (optional if you only use Standard agent)
ANTHROPIC_API_KEY=

# Live voice: LLM_PROVIDER is the server default for built-in profiles (when catalog has no realtimeProvider).
# Saved agents (Agent Studio) use each document's realtimeProvider; set OPENAI_API_KEY whenever any session may use OpenAI.
# LLM_PROVIDER=gemini
# OPENAI_API_KEY=

# Optional: Cartesia Sonic TTS — must opt in with CARTESIA_TTS_ENABLED=true (Gemini only; not used with OpenAI Realtime)
# CARTESIA_TTS_ENABLED=false
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=          # default: Barbershop Man (see examples/CARTESIA-TTS-README.md)
# CARTESIA_SPEED=normal       # slowest | slow | normal | fast | fastest
# CARTESIA_EMOTION=           # e.g. cheerful,friendly
# CARTESIA_MODEL_ID=sonic-2
# CARTESIA_LANGUAGE=en

# Server
HOST=0.0.0.0
PORT=9900

# Web client (when serving built client)
CLIENT_HOST=0.0.0.0
CLIENT_PORT=8080

# Optional: Claude Code workspace root (default ./workspaces); must be writable
# WORKSPACES_ROOT=./workspaces

# Optional: leave unset to use SDK bundled CLI; set to absolute path or command name if you install Claude Code separately
# CLAUDE_PATH=

# Optional: NanoClaw agent profile — path to NanoClaw installation (must contain groups/)
# NANOCLAW_ROOT=/path/to/nanoclaw

# Optional: User auth and persisted history (Supabase)
# AUTH_ENABLED=true
# AUTH_METHOD=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # required for Supabase-backed saved agents (004_user_agents.sql) + optional history store
# Optional: Agent Studio “bring your own key” — encrypts per-user Gemini/OpenAI keys at rest (run app/server/supabase/005_user_llm_api_keys.sql in Supabase SQL)
# USER_LLM_KEY_ENCRYPTION_SECRET=choose-a-long-random-secret-at-least-16-chars
# Google sign-in (Supabase Auth): enable the Google provider in the Supabase dashboard and add redirect URLs
# for your web app paths (e.g. http://localhost:8080/, http://localhost:8080/agent-studio for local Vite; PKCE uses query params, not #hash).

# Optional: Twilio inbound phone calls (disabled when unset)
# TWILIO_INBOUND_ENABLED=true
# TWILIO_WEBHOOK_URL=https://bodhiagent.live
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_OUTBOUND_ENABLED=true
# TWILIO_OUTBOUND_FROM=+14155550100
#
# Local phone testing (one command — reads ngrok URL automatically):
#   pnpm start:twilio-local

# Optional: per-surface greeting interruption policy (default: interruptible).
# Set to false to make the greeting uninterruptible end-to-end on that surface:
# barge-in is suppressed and mic input is dropped until the greeting finishes
# playing (user speech during the greeting is discarded, not queued).
# GREETING_INTERRUPTION_ENABLED_WEB=false
# GREETING_INTERRUPTION_ENABLED_MOBILE=false
# GREETING_INTERRUPTION_ENABLED_PHONE=false
