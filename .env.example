# Copy to .env and fill in only what you use. Loaded from the repo root by the examples
# (pnpm tsx examples/...). Individual example READMEs list any extra variables they read.

# Realtime model providers
GEMINI_API_KEY=                 # Gemini Live (GOOGLE_API_KEY is accepted as an alias)
# OPENAI_API_KEY=               # OpenAI Realtime
# QWEN_API_KEY=                 # Qwen Omni Realtime (DASHSCOPE_API_KEY also works)
# LLM_PROVIDER=gemini           # default provider for the framework server config

# Voice server (examples listen here; the web client connects to it)
HOST=0.0.0.0
PORT=9900

# Shared browser client (pnpm web-client)
# CLIENT_HOST=0.0.0.0
# CLIENT_PORT=8080

# Metrics demo (examples/metrics-demo.ts)
# METRICS_PORT=9464

# Logging
# LOG_LEVEL=info                # debug | info | warn | error
# LOG_FORMAT=text

# Optional auth / rate-limit / session controls (framework server config)
# AUTH_ENABLED=false
# AUTH_METHOD=anonymous         # anonymous | api_key | jwt | oauth | supabase
# AUTH_API_KEY=                 # required when AUTH_METHOD=api_key
# JWT_SECRET=                   # required when AUTH_METHOD=jwt
# MAX_SESSIONS_PER_USER=5
# MAX_TOTAL_SESSIONS=1000
# SESSION_TIMEOUT_MS=1800000
# CLEANUP_INTERVAL_MS=60000
# RATE_LIMITING_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MIN=60
# RATE_LIMIT_CONNECTIONS_PER_MIN=10

# Optional Supabase auth backend (AUTH_METHOD=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Twilio telephony (twilio-demo.ts, twilio-inbound-bridge.ts)
# TWILIO_INBOUND_ENABLED=true
# TWILIO_WEBHOOK_URL=https://your-public-url.example.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# HUMAN_AGENT_PHONE=
# TWILIO_WEBHOOK_PORT=8766
# AGENT_WS_URL=ws://localhost:9900

# Optional Cartesia TTS demo (cartesia-tts-demo.ts)
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# CARTESIA_SPEED=normal
# CARTESIA_EMOTION=

# Optional Claude Code demo (examples/claude_code)
# ANTHROPIC_API_KEY=
# PROJECT_DIR=/path/to/your/project

# Optional OpenClaw demo (examples/openclaw)
# OPENCLAW_URL=ws://127.0.0.1:18789
# OPENCLAW_TOKEN=
# OPENCLAW_HTTP_URL=
# OPENCLAW_HTTP_TOKEN=
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_MODEL=openclaw/default

# Optional SpatialReal avatar demo (examples/spatialreal_avatar_websdk)
# SPATIALREAL_API_KEY=
# SPATIALREAL_APP_ID=
# SPATIALREAL_AVATAR_ID=
# SPATIALREAL_REGION=us-west
# SPATIALREAL_ENV=intl
