# LiveKit example — environment.
#
# Run all commands from examples/livekit/. If you already export these
# (e.g. in ~/.zshrc), you don't need this file:
#   pnpm dev                  # inherits your shell env
# Otherwise copy this to `.env` and run with:
#   tsx --env-file=.env bodhi-stt-llm-tts.ts dev

# --- LiveKit (always required) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Provider path: "plugins" (default) or "inference" ---
# plugins   = Deepgram STT + OpenAI LLM + Cartesia TTS (keys below)
# inference = LiveKit Cloud gateway for all three (needs only LIVEKIT_* above)
PROVIDER=plugins

# --- Provider keys (required when PROVIDER=plugins) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# --- Image / video generation (Gemini + Veo) ---
GEMINI_API_KEY=

# --- Optional ---
# CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
