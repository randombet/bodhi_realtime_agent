{
  "name": "bodhi-realtime-agent",
  "version": "0.3.0",
  "private": false,
  "description": "TypeScript framework for real-time voice agent applications using Google Gemini Live API",
  "homepage": "https://github.com/randombet/bodhi_realtime_agent#readme",
  "bugs": {
    "url": "https://github.com/randombet/bodhi_realtime_agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randombet/bodhi_realtime_agent.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./observability": {
      "import": {
        "types": "./dist/observability/index.d.ts",
        "default": "./dist/observability/index.js"
      },
      "require": {
        "types": "./dist/observability/index.d.cts",
        "default": "./dist/observability/index.cjs"
      }
    },
    "./observability/opentelemetry": {
      "import": {
        "types": "./dist/observability/opentelemetry.d.ts",
        "default": "./dist/observability/opentelemetry.js"
      },
      "require": {
        "types": "./dist/observability/opentelemetry.d.cts",
        "default": "./dist/observability/opentelemetry.cjs"
      }
    }
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm ensure:client-protocol && tsup",
    "build:protocol": "tsc -p clients/client-protocol/tsconfig.json",
    "ensure:client-protocol": "tsc -p clients/client-protocol/tsconfig.json && tsc -p clients/web-voice/tsconfig.json",
    "demo:direct-rtc": "tsx examples/direct-rtc-demo/server.ts",
    "examples:setup": "bash scripts/examples-setup.sh",
    "web-client": "tsx examples/web-client.ts",
    "test": "pnpm ensure:client-protocol && vitest run",
    "test:watch": "pnpm ensure:client-protocol && vitest",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/",
    "typecheck": "pnpm ensure:client-protocol && tsc --noEmit",
    "typecheck:tests": "pnpm ensure:client-protocol && tsc -p tsconfig.test.json",
    "typecheck:examples": "pnpm ensure:client-protocol && tsc -p tsconfig.examples.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm ensure:client-protocol && typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "git config core.hooksPath .githooks && tsc -p clients/client-protocol/tsconfig.json && tsc -p clients/web-voice/tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@evan/opus": "^1.0.3",
    "@google/genai": "^1.41.0",
    "ai": "^4.3.0",
    "openai": "^6.25.0",
    "twilio": "^5.13.1",
    "werift": "^0.23.0",
    "write-file-atomic": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.3.24",
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@biomejs/biome": "^1.9.0",
    "@bodhi/client-protocol": "link:clients/client-protocol",
    "@braintree/sanitize-url": "^7.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cytoscape": "^3.33.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.20",
    "debug": "^4.4.3",
    "dotenv": "^16.4.5",
    "mermaid": "^11.12.2",
    "tsup": "^8.4.0",
    "tsx": "^4.8.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
